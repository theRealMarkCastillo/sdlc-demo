# =============================================================================
# Environment variables template for SDLC Demo
# =============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# WARNING: .env contains secrets and MUST NEVER be committed to version control.
# It is already listed in .gitignore.
# =============================================================================

# PostgreSQL superuser / application database password
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
POSTGRES_PASSWORD=change-me-to-a-strong-random-value

# Application database password (must match POSTGRES_PASSWORD in dev/staging/prod)
DB_PASS=change-me-to-a-strong-random-value
