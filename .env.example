# =============================================================================
# Environment variables templates for SDLC Demo
# =============================================================================
# Copy to environment-specific files and fill in real values:
#   cp .env.example .env.staging   # then edit with staging secrets
#   cp .env.example .env.prod      # then edit with production secrets
#
# Each environment gets its own secrets file (not shared). Generate strong
# random values for each, e.g.:
#   openssl rand -hex 32
#
# WARNING: These files contain secrets and MUST NEVER be committed.
# .env, .env.staging, .env.prod, and secrets/ are already in .gitignore.
# .dockerignore blocks them from being copied into Docker build context.
#
# Secrets are injected via Docker Compose file-based secrets (mounted at
# /run/secrets/) — they are NOT passed as environment variables, so they
# do not appear in `docker inspect` output.
# =============================================================================

# ---------------------------------------------------------------------------
# Shared / dev-only variables (used as fallback when env-specific vars unset)
# ---------------------------------------------------------------------------

# PostgreSQL superuser / application database password
POSTGRES_PASSWORD=change-me-to-a-strong-random-value

# Application database user
DB_USER=sdlc_user

# Application database password
DB_PASS=change-me-to-a-strong-random-value

# API key for authenticating mutating endpoints (POST, PUT, DELETE)
SDLC_API_KEY=change-me-to-a-strong-random-value

# User ID mapped to the API key for identity checks on PUT /api/users/<id>
SDLC_API_KEY_USER_ID=1

# ---------------------------------------------------------------------------
# Staging-specific secrets — copy to .env.staging and fill in real values
# These override the shared defaults above when deploy.sh runs for staging.
# ---------------------------------------------------------------------------
STAGING_POSTGRES_PASSWORD=change-me-to-a-strong-random-value
STAGING_DB_PASS=change-me-to-a-strong-random-value
STAGING_SDLC_API_KEY=change-me-to-a-strong-random-value

# ---------------------------------------------------------------------------
# Production-specific secrets — copy to .env.prod and fill in real values
# These override the shared defaults above when deploy.sh runs for prod.
# ---------------------------------------------------------------------------
PROD_POSTGRES_PASSWORD=change-me-to-a-strong-random-value
PROD_DB_PASS=change-me-to-a-strong-random-value
PROD_SDLC_API_KEY=change-me-to-a-strong-random-value
