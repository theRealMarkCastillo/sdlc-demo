# =============================================================================
# Environment variables template for SDLC Demo
# =============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# WARNING: .env contains secrets and MUST NEVER be committed to version control.
# It is already listed in .gitignore.
# =============================================================================

# PostgreSQL superuser / application database password
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
POSTGRES_PASSWORD=change-me-to-a-strong-random-value

# Application database user
DB_USER=change-me-db-user

# Application database password (must match POSTGRES_PASSWORD in dev/staging/prod)
DB_PASS=change-me-to-a-strong-random-value

# API key for authenticating mutating endpoints (POST, PUT, DELETE)
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
SDLC_API_KEY=change-me-to-a-strong-random-value

# User ID mapped to the API key for identity checks on PUT /api/users/<id>
# The caller can only update the user whose ID matches this value.
SDLC_API_KEY_USER_ID=1
